# ==========================================
# AROGYA QUEUE — ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase Database Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# ==========================================
# REAL SMS OTP SERVICE CONFIGURATION
# ==========================================
# Supported providers: msg91, twilio, fast2sms
# Choose one provider and supply the matching credentials below.
SMS_PROVIDER=MSG91

# Option 1: MSG91 (Recommended for India)
# 1. Sign up at https://msg91.com
# 2. Obtain your Auth Key under Settings -> API Keys
# 3. Create an OTP template (e.g., "Your Arogya Queue verification code is ##OTP##.")
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=AROGYA

# Option 2: Twilio
# 1. Sign up at https://twilio.com
# 2. Get Account SID, Auth Token from Console Dashboard
# 3. Purchase or configure an SMS Phone Number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option 3: Fast2SMS (India Bulk SMS / OTP)
# 1. Sign up at https://fast2sms.com
# 2. Obtain your Dev API authorization key
FAST2SMS_API_KEY=
